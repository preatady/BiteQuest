# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# GEOAPIFY: Optional external places discovery and map styles
# VITE_GEOAPIFY_MAP_KEY: Optional client-side vector tile rendering for MapLibre (Falls back to OpenFreeMap)
VITE_GEOAPIFY_MAP_KEY=""
# GEOAPIFY_SERVER_KEY: Optional server-side key for live Geoapify Places Search (Falls back to Demo mode / Community Spots)
GEOAPIFY_SERVER_KEY=""

# ESRI ARCGIS: Optional client token for official Satellite Imagery Basemap
VITE_ESRI_BASEMAP_TOKEN=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
